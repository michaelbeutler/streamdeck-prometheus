{
  "name": "@iperka/streamdeck-prometheus",
  "version": "0.3.0",
  "description": "Stream Deck plugin for displaying Prometheus metrics with support for instant queries, range queries, histograms, and more",
  "author": "Michael Beutler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelbeutler/streamdeck-prometheus.git"
  },
  "bugs": {
    "url": "https://github.com/michaelbeutler/streamdeck-prometheus/issues"
  },
  "homepage": "https://github.com/michaelbeutler/streamdeck-prometheus#readme",
  "keywords": [
    "streamdeck",
    "elgato",
    "prometheus",
    "metrics",
    "monitoring",
    "observability",
    "devops"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart cloud.iperka.streamdeck-prometheus\"",
    "dev": "npm run watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "prepare": "cd .. && husky streamdeck-prometheus/.husky || true",
    "precommit": "npm run lint:fix && npm run format",
    "clean": "rm -rf coverage cloud.iperka.streamdeck-prometheus.sdPlugin/bin",
    "package": "npm run build && cd cloud.iperka.streamdeck-prometheus.sdPlugin && zip -r ../streamdeck-prometheus.streamDeckPlugin ."
  },
  "devDependencies": {
    "@elgato/cli": "^1.4.0",
    "@eslint/js": "^9.17.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node20": "^20.1.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "rollup": "^4.28.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "dependencies": {
    "@elgato/streamdeck": "^1.1.0",
    "prometheus-query": "^3.5.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,html,css}": [
      "prettier --write"
    ]
  }
}
